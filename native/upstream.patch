diff --git a/plugins/rust_api/hook/build.dart b/plugins/rust_api/hook/build.dart
index 9780ef0..59c80e5 100644
--- a/plugins/rust_api/hook/build.dart
+++ b/plugins/rust_api/hook/build.dart
@@ -33,7 +33,40 @@ Map<String, String> _bindgenEnvironment(BuildInput input) {
       '${llvmRoot.path}${Platform.pathSeparator}$name',
     );
     if (directory.existsSync() && directory.listSync().any(_isLibclang)) {
-      return {'LIBCLANG_PATH': directory.path};
+      final clangRoot = Directory('${directory.path}/clang');
+      final resources = clangRoot.existsSync()
+          ? clangRoot.listSync().whereType<Directory>().where((entry) {
+              return File('${entry.path}/include/stdbool.h').existsSync();
+            }).toList()
+          : <Directory>[];
+      if (resources.length != 1) {
+        throw StateError('Expected one NDK Clang resource directory');
+      }
+      final (
+        triple,
